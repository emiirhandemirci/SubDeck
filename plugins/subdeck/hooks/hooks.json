{
  "description": "SubDeck event logger: records subagent start/stop to .subdeck/events.jsonl",
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run-hook.cmd\" log-event SubagentStart",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run-hook.cmd\" log-event SubagentStop",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
