{
  "description": "SubDeck hooks: event logger (subagent start/stop, input-needed) to .subdeck/events.jsonl; local desktop notifications (toggle with /subdeck:settings); Bash/PowerShell/Write/Edit guard",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"SubDeck is installed. When you delegate work or launch sub-agents, load the subdeck:orchestrator skill first and follow it (model policy, task template, git rules, pre-push checklist, push only after explicit user approval). User commands: /subdeck:desk, /subdeck:status, /subdeck:settings.\"}}'",
            "shell": "bash",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run-hook.cmd\" log-event SubagentStart",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run-hook.cmd\" log-event SubagentStop",
            "shell": "bash",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run-hook.cmd\" notify hook agent",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run-hook.cmd\" log-event Notification",
            "shell": "bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "permission_prompt|elicitation_dialog|agent_needs_input|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run-hook.cmd\" notify hook waiting",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run-hook.cmd\" notify hook done",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run-hook.cmd\" guard",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
